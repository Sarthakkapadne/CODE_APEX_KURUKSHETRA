# ==========================================================
# LexPort — Production Environment Variables
# ==========================================================

# ── Backend Configuration (Render / Server) ──
APP_ENV=production
APP_VERSION=1.0.0
RULE_ENGINE_VERSION=LexPort-Rules-v2026.1
PORT=8000

# Strict Gemini LLM Selection (gemini-3.5-flash or gemini-3.6-flash ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Database (Supabase PostgreSQL or local SQLite)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For SQLite local fallback: sqlite+aiosqlite:///lexport.db
DATABASE_URL=sqlite+aiosqlite:///lexport.db

# MapTiler API Key for GIS Leaflet Tiles
MAPTILER_API_KEY=CTTf1GnjFmqpYI0cPqIC
NEXT_PUBLIC_MAPTILER_KEY=CTTf1GnjFmqpYI0cPqIC

# CORS Configuration
CORS_ORIGINS=*

# ── Frontend Configuration (Vercel) ──
# Set to your deployed backend URL on Render (e.g. https://lexport-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
