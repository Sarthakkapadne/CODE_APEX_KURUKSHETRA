{
  "manifest_version": 3,
  "name": "LexPort — Live Cross-Border Compliance Co-Pilot",
  "version": "1.0.0",
  "description": "Live pre-flight regulatory compliance auditor for Amazon, Shopify, and Walmart listings with real-time statutory remediation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon48.png",
    "default_title": "LexPort Compliance Co-Pilot"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "*://*.amazon.com/*",
    "*://*.amazon.in/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.co.jp/*",
    "*://*.walmart.com/*",
    "*://*.myshopify.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/scraper.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
