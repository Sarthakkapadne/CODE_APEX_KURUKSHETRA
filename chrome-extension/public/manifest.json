{
  "manifest_version": 3,
  "name": "LexPort Co-Pilot Scanner",
  "version": "1.0.0",
  "description": "Cross-Border Compliance Verification directly on product pages.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Scan Product"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
